{
  "author": "OpenWA Contributors",
  "description": "Official JavaScript/TypeScript SDK for OpenWA WhatsApp API Gateway",
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./dist/esm/index.js",
        "types": "./dist/esm/index.d.ts"
      },
      "require": {
        "default": "./dist/cjs/index.js",
        "types": "./dist/cjs/index.d.ts"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "whatsapp",
    "api",
    "sdk",
    "openwa",
    "gateway"
  ],
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "name": "@rmyndharis/openwa",
  "peerDependencies": {},
  "repository": {
    "directory": "sdk/javascript",
    "type": "git",
    "url": "https://github.com/rmyndharis/OpenWA"
  },
  "scripts": {
    "build": "node init && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}))\"",
    "dev": "node init && tsc -p tsconfig.esm.json --watch",
    "prepublishOnly": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/cjs/index.d.ts",
  "version": "0.5.0"
}
